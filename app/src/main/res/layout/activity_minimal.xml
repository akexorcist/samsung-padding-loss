<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <TextView
        android:id="@+id/tvMinimalReadout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/bg_diagnostics"
        android:fontFamily="monospace"
        android:padding="10dp"
        android:textColor="@color/white"
        android:textSize="11sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!--
      This is the view the bug hits - see themes.xml (SamsungPaddingLossTheme) for the actual root cause.
      A common bottom-bar arrangement: match_parent width with its own layout_margin from the
      screen edge, anchored to the bottom.

      android:paddingHorizontal/paddingVertical below are what get zeroed by the bug. The
      coloured background makes that visible without reading logcat: the label should sit
      clear of the coloured edges (paddingHorizontal="16dp" paddingVertical="12dp"). When the
      bug hits, both read 0 and the text sits flush against them instead.
    -->
    <LinearLayout
        android:id="@+id/paddedRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@color/accent"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvMinimal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/padded_label"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
