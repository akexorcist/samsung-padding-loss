<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      ROOT CAUSE: android:fitsSystemWindows="true" set here, at the theme/window level, is what
      triggers the bug - not any view, component, or layout below it.
    -->
    <style name="SamsungPaddingLossTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:fitsSystemWindows">true</item>
    </style>
</resources>
